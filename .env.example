# Rowta environment variables. Names and safe defaults only. NEVER put a real secret in this file.
#
# .env.example is committed. .env is NOT (git ignores it).
# Create your .env with:  node scripts/setup-env.mjs
#   - it generates the LOCAL secrets (database and Redis passwords, the token-signing secret),
#   - it never prints a value, only names,
#   - you paste third-party secrets (Flutterwave, SMTP, Expo, Sentry) into .env by hand.
# Check it any time with:  node scripts/setup-env.mjs --check
#
# Rules: S1, S2, S4 in .agents/rules/AGENT_RULES.md.
# Anything named EXPO_PUBLIC_* is compiled into the app and readable by anyone: NEVER a secret.
# [generated] = filled by the script. [derived] = built by the script from other names. [you] = you fill it by hand.

# ---- General ----------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
# Comma-separated list of allowed web origins (no wildcard; rule S11).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public address of the /web surface once you deploy it to Vercel (canonical URL, og:url, sitemap, App Links).
PUBLIC_WEB_URL=http://localhost:5173

# ---- Feature switches and limits (not secrets) --------------------------------------------------
CACHE_ENABLED=true
CRON_ENABLED=true
# Sanity ceiling for seats on the Team and Business plans (PRD section 5).
MAX_SEATS_CEILING=200
# Cap on concurrent Argon2id hashes; each uses about 19 MiB (rule A1). Size it to the host memory.
ARGON2_MAX_CONCURRENCY=2
TRUST_PROXY_HOPS=0

# ---- Databases (two PostgreSQL databases for the sharding simulation) ----------------------------
# DB0 is the global database AND shard 0. DB1 is shard 1 (PRD 7.1, 9.5).
DB0_NAME=rowta_db0
DB0_USER=rowta
DB0_PORT=5442
# [generated]
DB0_PASSWORD=
DB1_NAME=rowta_db1
DB1_USER=rowta
DB1_PORT=5443
# [generated]
DB1_PASSWORD=
# The application connects as a NON-OWNER role (server/prisma/sql/030-app-role.sql) so it cannot alter tables or the ledger.
DB_APP_USER=rowta_app
# [generated]
DB_APP_PASSWORD=
# Owner connections: used only by setup, the SQL files and prisma db pull. The running app and worker never use them.
# [derived]
DB0_ADMIN_URL=
# [derived]
DB1_ADMIN_URL=
# Connection strings the app and worker use. [derived] from the parts above (role DB_APP_USER). READ equals WRITE until a real replica exists (PRD 9.4).
# [derived]
DB0_WRITE_URL=
# [derived]
DB0_READ_URL=
# [derived]
DB1_WRITE_URL=
# [derived]
DB1_READ_URL=

# ---- Redis (rate limits, locks, cache, BullMQ) --------------------------------------------------
REDIS_PORT=6390
# [generated]
REDIS_PASSWORD=
# [derived]
REDIS_URL=

# ---- Token signing -----------------------------------------------------------------------------
# HS512 signing secret for the 15-minute access token (rule A4). At least 64 random bytes.
# [generated]
JWT_ACCESS_SECRET=

# ---- Email (nodemailer over SMTP; rule A13, PRD Q7) ---------------------------------------------
# Development default: a local mail catcher (Mailpit) that receives mail and sends nothing out.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAILPIT_UI_PORT=8025
MAIL_FROM=Rowta <no-reply@example.test>
# Only needed for a real SMTP server. Leave empty for the local catcher.
# [you]
SMTP_USER=
# [you]
SMTP_PASSWORD=

# ---- Payments (Flutterwave, test mode; PRD 8.6) -------------------------------------------------
# Test keys only. [VERIFY] exact variable meanings and the webhook signature scheme in Flutterwave's current docs.
PAYMENT_PROVIDER=flutterwave
PAYMENT_MODE=test
# [you] test key
FLW_PUBLIC_KEY=
# [you] test key
FLW_SECRET_KEY=
# [you] test key, only if the current API needs it [VERIFY]
FLW_ENCRYPTION_KEY=
# [you] the secret you also enter in the Flutterwave dashboard webhook settings [VERIFY]
FLW_WEBHOOK_SECRET_HASH=
# DEV ONLY: a fake provider that lets the payment flow run without real keys. The server MUST refuse to start
# if this is true while NODE_ENV=production (rule P7).
PAYMENT_SIMULATOR_ENABLED=true

# ---- Push notifications ------------------------------------------------------------------------
# Optional Expo access token for authenticated push sends [VERIFY].
# [you] optional
EXPO_ACCESS_TOKEN=

# ---- Error reporting ---------------------------------------------------------------------------
# [you] optional
SENTRY_DSN_SERVER=
SENTRY_ENVIRONMENT=development

# ---- Values compiled into the app (PUBLIC by design; never a secret; listed in docs/SECURITY.md) --
# 10.0.2.2 is how the Android emulator reaches your computer's localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# [you] optional; a Sentry DSN is public by design
EXPO_PUBLIC_SENTRY_DSN=
# [you] from your EAS project (Phase 12)
EXPO_PUBLIC_EAS_PROJECT_ID=
