{
  "name": "@rowta/app",
  "version": "0.0.0",
  "private": true,
  "description": "Rowta mobile app (Expo, Android). TypeScript; auth is one AuthGate screen with views (PRD 6.1).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node ../scripts/check-ui-tokens.mjs && node ../scripts/check-app-strings.mjs && node ../scripts/check-app-a11y.mjs",
    "check:a11y": "node ../scripts/check-app-a11y.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "0.4.1",
    "@expo/metro-runtime": "58.0.14",
    "@expo/vector-icons": "15.1.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.104.4",
    "expo": "58.0.16",
    "expo-font": "58.0.9",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-notifications": "58.1.5",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "puppeteer-core": "25.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
