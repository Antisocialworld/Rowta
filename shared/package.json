{
  "name": "@rowta/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and constants shared by the Rowta app and server (rule V1: written once, imported by both).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./messages": {
      "types": "./src/messages.ts",
      "default": "./src/messages.ts"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
